# Server port number
PORT=3400

# MongoDB connection string
MONGODB_URL=mongodb://127.0.0.1:27017/vendo

# Cookie signing secret (random string)
COOKIE_SECRET_KEY=change-me-to-a-long-random-string

# JWT signing secret (random string)
JWT_SECRET_KEY=change-me-to-another-long-random-string

# Node environment (development or production)
NODE_ENV=development

# Map.ir API key for reverse geocoding (optional)
MAP_IR_URL=https://api.map.ir/v5/reverse
MAP_API_KEY=

# OTP code expiration in milliseconds (default 2 minutes)
OTP_EXPIRES_MS=120000

# Rate limit window in milliseconds (default 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Max requests per IP per window for send-otp
RATE_LIMIT_SEND_OTP=5

# Max requests per IP per window for check-otp
RATE_LIMIT_CHECK_OTP=10